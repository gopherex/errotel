  "repository": {
    "type": "git",
    "url": "git+https://github.com/gopherex/errotel.git",
    "directory": "packages/api"
  },
  "homepage": "https://github.com/gopherex/errotel#readme",
  "bugs": {
    "url": "https://github.com/gopherex/errotel/issues"
  },
