{
  "name": "@gopherex/errotel-sdk",
  "version": "1.0.1",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./otlp": {
      "types": "./dist/otlp.d.ts",
      "import": "./dist/otlp.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/sdk-version.mjs && tsc",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <1.10.0"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.222.0",
    "@opentelemetry/resources": "2.11.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1"
  },
  "description": "Browser error capture with OpenTelemetry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gopherex/errotel.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/gopherex/errotel#readme",
  "bugs": {
    "url": "https://github.com/gopherex/errotel/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
