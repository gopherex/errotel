{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/sdk/src",
    "app/src/env.d.ts",
    "examples/browser",
    "tests/unit",
    "tests/browser",
    "vitest.config.ts"
  ]
}
